      ${medicines.map(m=>`<option value="${m.id}">${esc(m.name)} — ${esc(m.batch_number)} (${m.quantity} units)</option>`).join('')}
     </select>
    </div>
    <div class="field">
     <label for="stockQuantity">${receiving?'Quantity received':'Quantity to adjust'}</label>
     <input id="stockQuantity" type="number" min="1" max="100000" step="1" required placeholder="Enter units">
    </div>
    ${receiving?'':`<div class="field">
     <label for="stockDirection">Adjustment type</label>
     <select id="stockDirection">
      <option value="out">Remove stock</option>
      <option value="in">Add stock</option>
     </select>
    </div>`}
    <div class="field">
     <label for="stockReason">Reason</label>
