 e.preventDefault();const form=e.currentTarget;const payload=Object.fromEntries(new FormData(form).entries());
 for(const k of ['quantity','reorder_level'])payload[k]=Number(payload[k]);payload.unit_price=Number(payload.unit_price);
 $('saveBtn').disabled=true;$('saveBtn').textContent='Saving…';
 try{const id=form.dataset.editId;await request(id?'/api/medicines/'+id:'/api/medicines',{method:id?'PUT':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});closeModal();await load()}
