});

async function startSession(){
 try{
  const r=await fetch('/api/auth');
  if(!r.ok)throw Error('Unable to check login status');
  const data=await r.json();
  if(data.authenticated)showDashboard();
 }catch(e){
  $('loginError').textContent='Cannot connect to the application. Please refresh and try again.';
 }
}
function showDashboard(){
 document.body.classList.add('authenticated');
 if(!$('logoutBtn')){
  const b=document.createElement('button');
  b.id='logoutBtn';b.className='btn secondary';b.textContent='Sign out';
  b.addEventListener('click',async()=>{
   try{await request('/api/logout',{method:'POST'})}catch(e){}
   document.body.classList.remove('authenticated');
   $('loginPassword').value='';
   $('loginError').textContent='';
  });
  document.querySelector('.profile').appendChild(b);
 }
 load();
}
$('loginForm').addEventListener('submit',async e=>{
 e.preventDefault();
 const btn=$('loginBtn');
 btn.disabled=true;btn.textContent='Signing in…';$('loginError').textContent='';
 try{
  await request('/api/login',{
   method:'POST',
   headers:{'Content-Type':'application/json'},
   body:JSON.stringify({password:$('loginPassword').value})
  });
  $('loginPassword').value='';
  showDashboard();
 }catch(err){
  $('loginError').textContent=err.message==='Invalid password'?'Incorrect password. Please try again.':'Login failed. Please try again.';
 }finally{
  btn.disabled=false;btn.textContent='Sign in';
 }
});
startSession();

