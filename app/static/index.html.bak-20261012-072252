function esc(value){return String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function renderAlerts(){
 const alerts=medicines.filter(m=>status(m)[1]!=='ok').sort((a,b)=>daysTo(a.expiry_date)-daysTo(b.expiry_date));
 if(!alerts.length){$('alertsList').innerHTML='<div class="empty">All clear — no stock or expiry alerts.</div>';return}
 $('alertsList').innerHTML=alerts.slice(0,6).map(m=>{const s=status(m);return `<div class="alertrow"><div class="alertmark">${s[1]==='exp'?'◷':'⚑'}</div><div><strong>${esc(m.name)}</strong><p>${esc(m.batch_number)} · ${s[1]==='exp'?(daysTo(m.expiry_date)<0?'Expired':`Expires in ${daysTo(m.expiry_date)} days`):`${m.quantity} units remaining`}</p></div><span class="alertcount">${s[1]==='exp'?'Expiry':'Low stock'}</span></div>`}).join('');
}
function openModal(m=null){
 $('medicineForm').reset();$('formNotice').classList.add('hidden');
 $('medicineForm').dataset.editId=m?.id||'';
 $('medicineForm').dataset.originalQuantity=m?String(m.quantity):'';
 $('stockReasonField').classList.add('hidden');
 $('stock_change_reason').required=false;
 $('stock_change_reason').value='';
 $('modalTitle').textContent=m?'Edit medicine':'Add medicine';$('saveBtn').textContent=m?'Update medicine':'Save medicine';
 $('expiry_date').min=new Date().toISOString().slice(0,10);
 if(m)for(const [k,v] of Object.entries(m)){const input=$('medicineForm').elements.namedItem(k);if(input)input.value=v}
 $('modal').classList.remove('hidden');$('name').focus();
}
$('quantity').addEventListener('input',()=>{
 const form=$('medicineForm');
 const changed=!!form.dataset.editId &&
   Number($('quantity').value)!==Number(form.dataset.originalQuantity);
 $('stockReasonField').classList.toggle('hidden',!changed);
 $('stock_change_reason').required=changed;
 if(!changed)$('stock_change_reason').value='';
});
function closeModal(){$('modal').classList.add('hidden')}
