document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal()});
$('refreshBtn').addEventListener('click',load);$('search').addEventListener('input',render);
document.querySelectorAll('[data-view]').forEach(b=>b.addEventListener('click',()=>{
 const next=b.dataset.view;
 if(next==='valuation'){
  clearError();openValuation();return;
 }
 if(next==='medicine-form'){
  clearError();
  openModal();
  return;
 }
 if(next==='categories'){
  clearError();openCategories();return;
 }
 if(next==='reconciliation'){
  clearError();openReconciliation();return;
 }
 if(next==='movements'){
  clearError();openMovementHistory();return;
 }
 if(next==='receive-stock'||next==='adjustments'){
  clearError();openStockScreen(next);return;
 }
 if(!['overview','inventory','alerts','medicine-details','expired'].includes(next)){
  showError('This screen is planned but not implemented yet.');
  return;
 }
 clearError();
 view=next;
 document.querySelectorAll('[data-view]').forEach(x=>x.classList.toggle('active',x===b));
 const title=view==='overview'?'Overview':view==='inventory'?'Medicine inventory':view==='medicine-details'?'Medicine details & batches':view==='expired'?'Expired / Quarantine':'Stock & expiry alerts';
 $('crumb').textContent=title;
 $('pageTitle').textContent=view==='overview'?'Good day, pharmacist 👋':title;
 $('sectionTitle').textContent=view==='overview'?'Your pharmacy at a glance':title;
 $('sectionSub').textContent=view==='alerts'?'Batches requiring stock or expiry review.':'Live inventory data from your pharmacy database.';
 render();
}));
