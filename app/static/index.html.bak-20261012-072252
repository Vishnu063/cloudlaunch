   <div class="formactions">
    <button type="button" class="btn secondary" data-stock-close>Cancel</button>
    <button type="submit" class="btn" id="stockSubmit">Save stock change</button>
   </div>
  </form>
 </section>`;
 document.body.appendChild(modal);
 const close=()=>modal.remove();
 modal.addEventListener('click',e=>{
  if(e.target===modal||e.target.closest('[data-stock-close]'))close();
 });
 const onKey=e=>{
  if(e.key==='Escape'){close();document.removeEventListener('keydown',onKey)}
 };
 document.addEventListener('keydown',onKey);
 const form=modal.querySelector('#stockActionForm');
 form.addEventListener('submit',async e=>{
  e.preventDefault();
  const id=Number(modal.querySelector('#stockMedicine').value);
  const qty=Number(modal.querySelector('#stockQuantity').value);
  const reason=modal.querySelector('#stockReason').value.trim();
  const direction=receiving?'in':modal.querySelector('#stockDirection').value;
  const error=modal.querySelector('#stockActionError');
  error.classList.add('hidden');
  if(!id||!Number.isSafeInteger(qty)||qty<1||qty>100000||reason.length<3){
   error.textContent='Select a medicine, valid quantity, and reason (at least 3 characters).';
   error.classList.remove('hidden');
   return;
  }
  const change=direction==='out'?-qty:qty;
  const medicine=medicines.find(m=>m.id===id);
  if(!medicine)return;
  if(medicine.quantity+change<0){
   error.textContent='Insufficient stock. Available: '+medicine.quantity;
   error.classList.remove('hidden');
   return;
  }
  const submit=modal.querySelector('#stockSubmit');
  submit.disabled=true;
  try{
   await request('/api/medicines/'+id+'/stock',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({change,reason})
   });
   close();
   document.removeEventListener('keydown',onKey);
   await load();
  }catch(err){
   error.textContent=err.message;
   error.classList.remove('hidden');
  }finally{
   submit.disabled=false;
  }
 });
}


