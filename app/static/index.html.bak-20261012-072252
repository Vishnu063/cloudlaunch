function openReconciliation(){
 const modal=document.createElement('div');
 modal.className='modalback';
 modal.innerHTML=`<section class="modal" role="dialog" aria-modal="true" aria-labelledby="reconcileTitle">
  <div class="modalhead">
   <h2 id="reconcileTitle">Stock reconciliation</h2>
   <button class="close" type="button" data-reconcile-close>×</button>
  </div>
  <form id="reconcileForm">
   <div class="formgrid">
    <div class="field">
     <label for="recMedicine">Medicine / batch</label>
     <select id="recMedicine" required>
      <option value="">Select medicine</option>
      ${medicines.map(m=>`<option value="${m.id}">${esc(m.name)} — ${esc(m.batch_number)}</option>`).join('')}
     </select>
    </div>
    <div class="field">
     <label>Recorded stock</label>
     <div id="recRecorded">—</div>
    </div>
    <div class="field">
     <label for="recActual">Physical stock counted</label>
     <input id="recActual" type="number" min="0" step="1" required>
    </div>
    <div class="field">
     <label>Difference</label>
     <div id="recDifference">—</div>
    </div>
    <div class="field">
     <label for="recReason">Reason</label>
     <input id="recReason" maxlength="200" minlength="3" required
      placeholder="Physical stock count correction">
    </div>
   </div>
   <div id="recError" class="error hidden" role="alert"></div>
   <div class="formactions">
    <button type="button" class="btn secondary" data-reconcile-close>Cancel</button>
    <button type="submit" class="btn" id="recSave">Reconcile stock</button>
   </div>
  </form>
 </section>`;

 document.body.appendChild(modal);
 const close=()=>{
  document.removeEventListener('keydown',onKey);
  modal.remove();
 };
 const onKey=e=>{if(e.key==='Escape')close()};
 document.addEventListener('keydown',onKey);

 modal.addEventListener('click',e=>{
  if(e.target===modal||e.target.closest('[data-reconcile-close]'))close();
 });

 const select=modal.querySelector('#recMedicine');
 const actual=modal.querySelector('#recActual');
 const difference=modal.querySelector('#recDifference');
 const recorded=modal.querySelector('#recRecorded');
 const error=modal.querySelector('#recError');

 function currentMedicine(){
  return medicines.find(m=>m.id===Number(select.value));
 }
 function calculate(){
  const m=currentMedicine();
  recorded.textContent=m?m.quantity+' units':'—';
  const qty=actual.value.trim()===''?NaN:Number(actual.value);
  difference.textContent=m&&Number.isSafeInteger(qty)&&qty>=0
   ?(qty-m.quantity>0?'+':'')+(qty-m.quantity)+' units'
   :'—';
 }
 select.addEventListener('change',()=>{
  actual.value='';
  calculate();
 });
 actual.addEventListener('input',calculate);

 modal.querySelector('#reconcileForm').addEventListener('submit',async e=>{
  e.preventDefault();
  error.classList.add('hidden');
  const m=currentMedicine();
  const qty=actual.value.trim()===''?NaN:Number(actual.value);
  const reason=modal.querySelector('#recReason').value.trim();
  if(!m||!Number.isSafeInteger(qty)||qty<0||reason.length<3){
   error.textContent='Select a medicine, enter valid physical stock and a reason.';
   error.classList.remove('hidden');
   return;
  }
  const button=modal.querySelector('#recSave');
  button.disabled=true;
  try{
   const latest=await request('/api/medicines');
   const live=latest.find(x=>x.id===m.id);
   if(!live)throw Error('Medicine no longer exists.');
   if(live.quantity!==m.quantity){
    throw Error('Recorded stock changed. Close and reopen reconciliation to refresh.');
   }
   const change=qty-live.quantity;
   if(change===0){
    close();
    return;
   }
   if(Math.abs(change)>100000){
    throw Error('Difference exceeds the maximum allowed adjustment (100,000 units).');
   }
   if(!confirm(`Adjust ${m.name} stock from ${live.quantity} to ${qty} units?`)){
    return;
   }
   await request('/api/medicines/'+m.id+'/stock',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({change,reason:'Stock reconciliation: '+reason})
   });
   close();
   await load();
  }catch(err){
   error.textContent=err.message;
   error.classList.remove('hidden');
  }finally{
   button.disabled=false;
  }
 });
}


